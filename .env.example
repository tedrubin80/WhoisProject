# WHOIS Intelligence Server - Environment Variables
# Copy this file to .env and fill in your values

# ===== APPLICATION CONFIGURATION =====
NODE_ENV=production
PORT=3001

# ===== API KEYS (REQUIRED IN PRODUCTION) =====
# Generate secure API keys (minimum 16 characters)
# Example: openssl rand -hex 32
# You can configure up to 5 API keys for different clients/purposes

API_KEY_1=your-secure-api-key-here-min-16-chars
API_KEY_2=
API_KEY_3=
API_KEY_4=
API_KEY_5=

# ===== RAILWAY DEPLOYMENT NOTES =====
# 1. Railway automatically sets PORT - you can omit it
# 2. Set NODE_ENV to 'production' in Railway environment variables
# 3. Add at least one API_KEY_* variable in Railway dashboard
# 4. API keys must be at least 16 characters for security
# 5. Generate secure keys using: openssl rand -hex 32

# ===== OPTIONAL: DATABASE (if needed in future) =====
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===== OPTIONAL: LOGGING =====
# LOG_LEVEL=info

# ===== OPTIONAL: RATE LIMITING =====
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
